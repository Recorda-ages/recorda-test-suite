# Copy to `.env` and fill in the deployed passwords. Everything else has a default.

# --- Deployed backend (the default) -----------------------------------------------------
# Seed passwords of the AWS backend (SEED_USER_PASSWORD / SEED_ADMIN_PASSWORD in its
# deploy/.env.prod). Required by `pnpm test`; ask the team. Never commit them.
E2E_DEPLOYED_USER_PASSWORD=
E2E_DEPLOYED_ADMIN_PASSWORD=

# --- What is tested ----------------------------------------------------------------------
# Defaults: production web build against the deployed AWS backend.
# `pnpm test:local` / `pnpm test:local:prod` override these two for the local stack.
#
# Frontend build: prod (expo export, default) | dev (Expo dev server)
# E2E_TARGET=prod
# Backend: https://77-113-61-139.sslip.io (default) | http://localhost:8000 (local Docker)
# E2E_API_URL=https://77-113-61-139.sslip.io

# --- Local stack -------------------------------------------------------------------------
# Seed passwords of the local Docker backend; must match recorda-backend/.env.
# E2E_USER_PASSWORD=User@1234
# E2E_ADMIN_PASSWORD=Admin@1234

# --- Other -------------------------------------------------------------------------------
# Where the web build is served. The deployed backend only accepts this origin (CORS).
# E2E_BASE_URL=http://localhost:8081
# Path to the frontend repo: used to build/serve the app and to read i18n strings.
# E2E_FRONTEND_DIR=../recorda-frontend
# Set to 1 to skip starting the frontend (when you serve it yourself).
# E2E_SKIP_WEB_SERVER=1
# The browser window is visible by default when running locally (headless in CI).
# E2E_HEADLESS=1
# Slow every action down (ms) to follow the run by eye.
# E2E_SLOW_MO=400
